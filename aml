#!/usr/bin/env bash
# ============================================================================
# aml — orquestador local de Sovereign AML
#
#   ./aml up | run | deploy   Verifica Postgres local, migra, y levanta API + Streamlit
#   ./aml down | stop         Detiene API y Streamlit (Postgres sigue corriendo: es tuyo)
#   ./aml status              Estado de Postgres, API y Streamlit
#   ./aml logs [api]          Logs en vivo de la API
#   ./aml migrate             Aplica migraciones (ORM + SQL) sin levantar servicios
#   ./aml seed                Carga catálogos globales y una licencia de prueba
#   ./aml dump                Backup de la base local -> backups/
#   ./aml restore <archivo>   Restaura un .dump en la base local (sobreescribe)
#   ./aml railway-pull        Descarga un dump fresco de Railway (producción) -> backups/
#   ./aml help                Esta ayuda
# ============================================================================
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

VENV_DIR="aml_env"
STATE_DIR=".aml"
PID_DIR="$STATE_DIR/pids"
LOG_DIR="$STATE_DIR/logs"
BACKUP_DIR="backups"

mkdir -p "$PID_DIR" "$LOG_DIR" "$BACKUP_DIR"

log()  { printf '\033[1;36m[aml]\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m[aml]\033[0m %s\n' "$1" >&2; }
err()  { printf '\033[1;31m[aml]\033[0m %s\n' "$1" >&2; }

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || { err "Falta '$1' en el PATH."; exit 1; }
}

load_env() {
    if [ ! -f .env ]; then
        warn ".env no existe. Generando plantilla..."
        python3 scripts/generate_env.py
        err "Edita .env (DB_USER/DB_PASS) con tus credenciales locales reales y vuelve a correr './aml $CMD'."
        exit 1
    fi
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
}

activate_venv() {
    require_cmd python3
    if [ ! -d "$VENV_DIR" ]; then
        log "Creando entorno virtual ($VENV_DIR) e instalando dependencias..."
        python3 -m venv "$VENV_DIR"
        # shellcheck disable=SC1091
        source "$VENV_DIR/bin/activate"
        pip install --upgrade pip >/dev/null
        pip install -r requirements.txt
    else
        # shellcheck disable=SC1091
        source "$VENV_DIR/bin/activate"
    fi
}

# Instalador oficial de PostgreSQL.org (EDB): sus binarios suelen no estar en PATH
for _pgbin in /Library/PostgreSQL/*/bin; do
    [ -d "$_pgbin" ] && export PATH="$_pgbin:$PATH"
done

pg_already_up() {
    pg_isready -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" >/dev/null 2>&1
}

ensure_local_postgres() {
    if pg_already_up; then
        log "Postgres ya está corriendo en ${DB_HOST:-localhost}:${DB_PORT:-5432}."
        return
    fi
    # Caso 1: instalador oficial PostgreSQL.org (EDB) — corre como LaunchDaemon del sistema
    if [ -d "/Library/PostgreSQL" ]; then
        local version
        version="$(basename "$(ls -d /Library/PostgreSQL/*/ 2>/dev/null | head -1)")"
        local daemon="com.edb.launchd.postgresql-${version}"
        if launchctl list 2>/dev/null | grep -q "$daemon"; then
            log "Postgres (instalador PostgreSQL.org, versión $version) ya registrado; esperando arranque..."
        else
            warn "Postgres (PostgreSQL.org $version) no responde. Inícialo con:"
            warn "  sudo launchctl start ${daemon}-startup"
            warn "(o desde DBeaver/pgAdmin, como sueles hacerlo)."
        fi
        return
    fi
    # Caso 2: Homebrew
    if command -v brew >/dev/null 2>&1; then
        local formula
        formula="$(brew services list 2>/dev/null | awk '/^postgresql/{print $1; exit}')"
        if [ -n "$formula" ]; then
            log "Iniciando Postgres ($formula) vía Homebrew..."
            brew services start "$formula"
            sleep 2
            return
        fi
    fi
    warn "No se detectó cómo arrancar Postgres automáticamente. Inícialo tú (DBeaver/pgAdmin/launchctl) y vuelve a correr './aml up'."
}

wait_for_db() {
    require_cmd pg_isready
    log "Esperando Postgres en ${DB_HOST:-localhost}:${DB_PORT:-5432}/${DB_NAME:-AML}..."
    for _ in $(seq 1 15); do
        if pg_isready -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -d "${DB_NAME:-AML}" -U "${DB_USER:-postgres}" >/dev/null 2>&1; then
            log "Postgres listo."
            return 0
        fi
        sleep 1
    done
    err "Postgres no respondió. Revisa el servicio y las credenciales en .env."
    exit 1
}

pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null; }

stop_pid() {
    local name="$1" file="$2"
    if pid_alive "$file"; then
        kill "$(cat "$file")" 2>/dev/null || true
        rm -f "$file"
        log "$name detenido."
    fi
}

start_api() {
    if pid_alive "$PID_DIR/api.pid"; then
        log "API ya corriendo (PID $(cat "$PID_DIR/api.pid"))."
        return
    fi
    log "Iniciando FastAPI (auth_api.py) en :8000..."
    nohup uvicorn auth_api:app --host 127.0.0.1 --port 8000 > "$LOG_DIR/api.log" 2>&1 &
    echo $! > "$PID_DIR/api.pid"
    sleep 1
}

cmd_up() {
    load_env
    ensure_local_postgres
    wait_for_db
    activate_venv
    log "Aplicando migraciones..."
    python scripts/db_migrate.py
    start_api
    log "Iniciando Streamlit (app.py) en :8501 (Ctrl+C detiene API + Streamlit)..."
    trap 'stop_pid "API" "$PID_DIR/api.pid"' INT TERM
    streamlit run app.py --server.port 8501 --server.address 0.0.0.0
}

cmd_down() {
    stop_pid "API" "$PID_DIR/api.pid"
    log "API y Streamlit detenidos. Postgres sigue corriendo (lo administras aparte)."
}

cmd_status() {
    load_env 2>/dev/null || true
    if pg_isready -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -d "${DB_NAME:-AML}" -U "${DB_USER:-postgres}" >/dev/null 2>&1; then
        log "Postgres: OK (${DB_HOST:-localhost}:${DB_PORT:-5432}/${DB_NAME:-AML})"
    else
        warn "Postgres: sin respuesta"
    fi
    if pid_alive "$PID_DIR/api.pid"; then log "API: corriendo (PID $(cat "$PID_DIR/api.pid"))"; else warn "API: detenida"; fi
    if curl -sf http://localhost:8501/_stcore/health >/dev/null 2>&1; then log "Streamlit: corriendo"; else warn "Streamlit: detenida"; fi
}

cmd_logs() { tail -f "$LOG_DIR/api.log"; }

cmd_migrate() { load_env; activate_venv; python scripts/db_migrate.py; }

cmd_seed() {
    load_env; activate_venv
    log "Cargando catálogos globales..."
    python scripts/seed_catalogos_globales.py
    log "Cargando licencia de prueba..."
    python scripts/seed_licencias.py
}

cmd_dump() {
    load_env
    local file="$BACKUP_DIR/local_$(date +%Y%m%d_%H%M%S).dump"
    PGPASSWORD="${DB_PASS:-}" pg_dump -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" \
        -U "${DB_USER:-postgres}" -d "${DB_NAME:-AML}" -F c -f "$file"
    log "Backup guardado en $file"
}

find_pg_restore_newest() {
    # Un pg_restore más nuevo que el servidor destino siempre es seguro; preferimos
    # el 18.x que ya se instaló para railway-pull si está disponible.
    for candidate in \
        /opt/homebrew/opt/postgresql@18/bin/pg_restore \
        /usr/local/opt/postgresql@18/bin/pg_restore \
        /Library/PostgreSQL/18/bin/pg_restore \
        "$(command -v pg_restore 2>/dev/null || true)"
    do
        [ -n "$candidate" ] && [ -x "$candidate" ] && { echo "$candidate"; return 0; }
    done
    return 1
}

cmd_restore() {
    local file="${1:?Uso: ./aml restore <archivo.dump>}"
    [ -f "$file" ] || { err "No existe: $file"; exit 1; }
    load_env
    local restore_bin
    restore_bin="$(find_pg_restore_newest)" || { err "No se encontró pg_restore en el PATH."; exit 1; }
    warn "Esto sobreescribe datos existentes en ${DB_NAME:-AML}."
    PGPASSWORD="${DB_PASS:-}" "$restore_bin" -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" \
        -U "${DB_USER:-postgres}" -d "${DB_NAME:-AML}" --clean --if-exists --no-owner --no-privileges "$file"
    log "Restauración completada ($restore_bin)."
}

cmd_railway_pull() { ./scripts/railway_pull.sh; }

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

CMD="${1:-help}"
case "$CMD" in
    up|run|deploy) cmd_up ;;
    down|stop)     cmd_down ;;
    status)        cmd_status ;;
    logs)          cmd_logs ;;
    migrate)       cmd_migrate ;;
    seed)          cmd_seed ;;
    dump)          cmd_dump ;;
    restore)       shift; cmd_restore "${1:-}" ;;
    railway-pull)  cmd_railway_pull ;;
    help|*)        usage ;;
esac
